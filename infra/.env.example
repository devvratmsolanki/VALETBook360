# Copy to infra/.env and adjust. docker compose auto-loads infra/.env.
# NEVER commit a real secret.

# Postgres (one cluster, a database per service: valet_auth, valet_core)
DB_USER=valet
DB_PASSWORD=valet
DB_PORT=5432

# Service ports (host side)
AUTH_PORT=8081
CORE_PORT=8082
# Realtime Socket.IO gateway (host side).
GATEWAY_PORT=8090

# Redis (pub/sub for realtime deltas + the Socket.IO redis-adapter).
# Host port is NON-DEFAULT (6380) to avoid clashing with a local Redis on 6379.
# Container-to-container traffic always uses the in-network 6379.
REDIS_PORT=6380

# Shared HS256 secret — MUST be byte-identical across auth-service,
# transaction-service, and realtime-gateway so JWTs mint in one verify in all.
# Must be at least 32 bytes (HS256 minimum). All three services enforce this at
# boot and will refuse to start if the constraint is violated.
#
# Rotation procedure (see docs/SECURITY.md for full steps):
#   1. Generate:  openssl rand -base64 48
#   2. Update the secret in your secret manager / env, keeping the OLD value live.
#   3. Rolling-restart all three services (zero-downtime: old tokens still valid
#      while they haven't expired yet — default TTL is 15 min).
#   4. After one full access-token TTL has elapsed, remove the old secret value.
#
# DEV ONLY default below — MUST be overridden in every non-local environment.
JWT_SECRET=dev-only-secret-change-me-32bytes-min!!
AUTH_JWT_ISSUER=valet-auth
AUTH_JWT_ACCESS_TTL=900
AUTH_JWT_REFRESH_TTL=2592000

# --- Login abuse controls (auth-service; Redis-backed) ----------------------
#
# TWO independent controls:
#
# 1. PER-IP FAILURE ceiling (coarse circuit-breaker):
#    Only FAILED login attempts consume this bucket — successful logins from the
#    same IP do NOT count. This means a shared egress IP (NAT / corporate proxy /
#    CGNAT) is never blocked by innocent users successfully logging in. The ceiling
#    trips only when a genuine credential-stuffing flood (many dozens of failures)
#    originates from one source IP. If you sit behind a reverse proxy that cannot
#    report a per-real-client signal, raise this ceiling further or rely solely on
#    the per-account lockout below.
AUTH_RL_IP_MAX=100           # max FAILED attempts per IP per window (default: 100)
AUTH_RL_IP_WINDOW=60         # window length, seconds (default: 60)
#
# 2. PER-ACCOUNT lockout (precise primary control):
#    After N consecutive failed logins for one email within the window, lock that
#    account (even a correct password is refused) for K seconds. This is the main
#    anti-brute-force control and is independent of the source IP.
AUTH_LOCK_MAX_FAILURES=5
AUTH_LOCK_WINDOW=900
AUTH_LOCK_SECONDS=900
#
# Trust the first hop of X-Forwarded-For (a reverse proxy sits in front in prod).
# Set false ONLY if auth-service is exposed directly with no trusted proxy,
# otherwise clients could spoof XFF to rotate their apparent IP and dodge the limit.
AUTH_RL_TRUST_XFF=true
# The auth-service login-guard reads Redis via REDIS_HOST/REDIS_PORT. In the
# compose network this must point at the in-network Redis (host "redis", 6379).

# --- Production secret fail-fast --------------------------------------------
# Run every Java service with the prod profile in non-local environments so a
# missing JWT_SECRET / DB_PASSWORD aborts boot (no insecure fallback):
#   SPRING_PROFILES_ACTIVE=prod
# See docs/SECURITY.md section 2 for details.

# CORS allowed origins — comma-separated list of origins/patterns permitted to
# make cross-origin requests to ALL services (auth, transaction, realtime-gateway).
# Dev default (used when this var is unset): http://localhost:*,http://127.0.0.1:*
# Production example:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#
# The wildcard port suffix ":*" is supported for local dev (matches any port on
# that scheme+host). Do NOT use a bare "*" in production — it defeats CORS.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Demo accounts are seeded by Flyway (V2) — no bootstrap env needed:
#   driver@valet.demo / Driver123   (role=driver, has seeded assignments)
#   operator@valet.demo / Operator123  (role=valet, has company assignment)
#   admin@valet.demo  / Admin123     (role=admin, can hit POST /auth/register)
