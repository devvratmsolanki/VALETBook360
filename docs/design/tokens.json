{
  "$schema": "https://design-tokens.org/schema.json",
  "_comment": "Vālet Design System tokens (DTCG format). Brand + surface ramps PRESERVED from tailwind.config.js; everything else new. Feed to a generator -> Flutter ThemeData/ColorScheme extension and/or Tailwind theme.",
  "color": {
    "brand": {
      "300": { "$type": "color", "$value": "#E84A7A" },
      "400": { "$type": "color", "$value": "#D42862" },
      "500": { "$type": "color", "$value": "#A60445", "$description": "THE accent. Max one filled use per screen." },
      "600": { "$type": "color", "$value": "#8A0339" },
      "700": { "$type": "color", "$value": "#6E032E" },
      "900": { "$type": "color", "$value": "#3A0119" }
    },
    "surface": {
      "950": { "$type": "color", "$value": "#030303" },
      "900": { "$type": "color", "$value": "#050505" },
      "800": { "$type": "color", "$value": "#0F0F0F" },
      "700": { "$type": "color", "$value": "#1A1A1A" },
      "600": { "$type": "color", "$value": "#2A2A2A" },
      "500": { "$type": "color", "$value": "#3A3A3A" }
    },
    "content": {
      "strong":   { "$type": "color", "$value": "#FFFFFF" },
      "default":  { "$type": "color", "$value": "#E6E6E6" },
      "muted":    { "$type": "color", "$value": "#9A9A9A" },
      "faint":    { "$type": "color", "$value": "#6B6B6B", "$description": "Decorative only — never load-bearing text (WCAG)." },
      "onAccent": { "$type": "color", "$value": "#0A0A0A" }
    },
    "status": {
      "queued":     { "$type": "color", "$value": "#7A8AA0", "$description": "waiting_for_driver" },
      "settled":    { "$type": "color", "$value": "#5A8FB0", "$description": "parked" },
      "secured":    { "$type": "color", "$value": "#5AA0A0", "$description": "key_in" },
      "active":     { "$type": "color", "$value": "#C77DAE", "$description": "requested — pulses" },
      "dispatched": { "$type": "color", "$value": "#D08A5A", "$description": "driver_assigned" },
      "moving":     { "$type": "color", "$value": "#D6A94E", "$description": "en_route" },
      "ready":      { "$type": "color", "$value": "#5BB98C", "$description": "arrived" },
      "done":       { "$type": "color", "$value": "#6B6B6B", "$description": "delivered — receded" }
    },
    "alert": {
      "warn":    { "$type": "color", "$value": "#E0A93A" },
      "danger":  { "$type": "color", "$value": "#E0564E" },
      "success": { "$type": "color", "$value": "#4FB97E" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "2px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "xl":   { "$type": "dimension", "$value": "24px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "Inter" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
    },
    "scale": {
      "display":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "34px", "lineHeight": "40px", "fontWeight": 700 } },
      "title-lg": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "24px", "lineHeight": "30px", "fontWeight": 700 } },
      "title":    { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "20px", "lineHeight": "26px", "fontWeight": 600 } },
      "body-lg":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "17px", "lineHeight": "24px", "fontWeight": 500 } },
      "body":     { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400 } },
      "label":    { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 600 } },
      "caption":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "$description": "Minimum on-screen text size." } },
      "mono-lg":  { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": "22px", "lineHeight": "28px", "fontWeight": 600 } },
      "mono":     { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": "15px", "lineHeight": "20px", "fontWeight": 500 } }
    }
  },
  "elevation": {
    "0":      { "$type": "shadow", "$value": { "surface": "surface.900", "shadow": "none" } },
    "1":      { "$type": "shadow", "$value": { "surface": "surface.800", "shadow": "0 1px 2px rgba(0,0,0,0.4)" } },
    "2":      { "$type": "shadow", "$value": { "surface": "surface.700", "shadow": "0 4px 12px rgba(0,0,0,0.5)" } },
    "3":      { "$type": "shadow", "$value": { "surface": "surface.800", "shadow": "0 -8px 32px rgba(0,0,0,0.6)" } },
    "accent": { "$type": "shadow", "$value": { "surface": "brand.500", "shadow": "0 4px 16px rgba(166,4,69,0.35)" } }
  },
  "motion": {
    "stateAdvance":  { "$type": "duration", "$value": "240ms", "$description": "spring(stiffness 320, damping 28)" },
    "cardEnter":     { "$type": "duration", "$value": "280ms" },
    "cardExit":      { "$type": "duration", "$value": "320ms" },
    "sheetOpen":     { "$type": "duration", "$value": "280ms" },
    "sheetClose":    { "$type": "duration", "$value": "220ms" },
    "tabSwitch":     { "$type": "duration", "$value": "200ms" },
    "pulse":         { "$type": "duration", "$value": "1600ms" },
    "celebration":   { "$type": "duration", "$value": "600ms" },
    "reducedMotion": { "$type": "duration", "$value": "120ms", "$description": "Fallback for all transitions when reduced-motion is on." }
  },
  "target": {
    "minTouch":   { "$type": "dimension", "$value": "48px" },
    "thumbBand":  { "$type": "dimension", "$value": "88px" },
    "navBar":     { "$type": "dimension", "$value": "80px" }
  }
}
